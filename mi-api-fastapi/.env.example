# Copia este archivo como mi-api-fastapi/.env y completa los valores marcados.
# El .env real NUNCA se sube a git (está en .gitignore).

APP_NAME=InkaSec API
# development | production  (production exige COOKIE_SECURE=true y SEED_DEMO_DATA=false)
APP_ENV=development

API_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:5173

# Local sin Docker: SQLite en un archivo. Con docker compose este valor se reemplaza
# automáticamente por el PostgreSQL del contenedor "db".
DATABASE_URL=sqlite:///./inkasec.db

# OBLIGATORIO: mínimo 32 caracteres o la API no arranca. Genera uno propio con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=cambiame
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30

# En local por HTTP: false. En producción (HTTPS): true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Proxies de confianza delante de la API (Render = 1). En local: 0.
TRUSTED_PROXY_HOPS=0

# Crea la empresa demo, 3 usuarios y 7 módulos al arrancar (solo desarrollo).
SEED_DEMO_DATA=true
# Contraseña de los usuarios demo: mínimo 8 caracteres (el login del front lo exige).
DEMO_PASSWORD=cambia-esta-clave-demo

AUTO_CREATE_TABLES=true

# Mínimo 365 (RNF-06: la auditoría se conserva al menos 12 meses).
AUDIT_RETENTION_DAYS=365

ARCH_VARIANT=basic

# Solo para crear el primer administrador real con: python -m app.bootstrap_admin
BOOTSTRAP_COMPANY_NAME=InkaSec
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_TOTP_SECRET=
